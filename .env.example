# Copy to .env and fill in. .env is gitignored and must never be committed.

# Root folder holding <year>/Research Article*/*.pdf
CHI_CORPUS=C:\path\to\CHI

# Needed only from the judge module onward
OPENAI_API_KEY=

# Optional: the folder holding the human annotations (released separately), for the evaluate_* scripts.
# Default: data/annotations inside this repo.
ANNOTATIONS=

# Optional: v1's pipeline folder, to score v1 next to v2 (evaluate_q1.py). Leave empty to skip.
V1_DIR=
